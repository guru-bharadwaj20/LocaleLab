{
  "name": "localelab",
  "version": "0.1.0",
  "description": "Local-first, multi-locale website QA runner. One URL, many browser realities.",
  "license": "MIT",
  "author": "Guru Bharadwaj",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "localelab": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/test",
    "fixtures",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "demo": "node dist/cli.js demo",
    "benchmark": "node dist/cli.js benchmark",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test \"dist/test/**/*.test.js\""
  },
  "keywords": [
    "localization",
    "i18n",
    "l10n",
    "playwright",
    "qa",
    "testing",
    "locale",
    "timezone",
    "rtl"
  ],
  "dependencies": {
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guru-bharadwaj20/localelab.git"
  },
  "bugs": {
    "url": "https://github.com/guru-bharadwaj20/localelab/issues"
  },
  "homepage": "https://github.com/guru-bharadwaj20/localelab#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
